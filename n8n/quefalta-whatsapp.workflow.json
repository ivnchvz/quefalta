      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        -40
      ],
      "parameters": {
        "jsCode": "// Runs before anything else: if the user asked for a plan, acknowledge immediately.\nconst ev = $input.first().json.body || {};\nconst d = ev.data || {};\nconst picked = (d.content && d.content.interactiveReply && d.content.interactiveReply.id) || '';\nconst asksPlan = ev.type === 'message.inbound' && d.channel === 'whatsapp' && d.from &&\n  ((d.text || '').toLowerCase().includes('quiero mi plan') || picked.startsWith('plan|'));\nif (!asksPlan) return [];\nreturn [{ json: { to: d.from, channel: 'whatsapp', text: '✅ ¡Recibido! Estoy preparando tu plan con los datos de la zona; te llega en unos segundos… ⏳' } }];\n"
      }
    },
