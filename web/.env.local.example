# Option A: Anthropic API (default)
ANTHROPIC_API_KEY=

# Option B: AWS Bedrock with the hackathon AWS credits
# CLAUDE_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile   # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# Live Google Maps check (Places API (New), Google Cloud project with billing enabled)
GOOGLE_PLACES_API_KEY=

# WhatsApp via Zavu. zv_test_ keys send from Zavu's sandbox number, only to phones verified in the dashboard (Sandbox).
ZAVU_API_KEY=
# Optional: phone (E.164, e.g. +5216141234567) used for test sends
ZAVU_TEST_PHONE=

# Public URL of this app (tunnel or deploy) so Zavu can download the PDF, e.g. https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=

# n8n Cloud: instance URL (e.g. https://yourteam.app.n8n.cloud) and API key (Settings -> n8n API)
N8N_BASE_URL=
N8N_API_KEY=
